            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Kavya Patel\",\n  \"email\": \"kavya@eventhub.com\",\n  \"password\": \"password123\",\n  \"role\": \"user\"\n}"
        },
        "url": {
          "raw": "http://localhost:5000/api/auth/register",
          "protocol": "http",
          "host": ["localhost"],
          "port": "5000",
          "path": ["api", "auth", "register"]
        },
        "description": "Registers a new user and returns a signed JWT token (201 Created)."
      },
      "response": []
    },
